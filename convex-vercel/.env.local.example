# Required environment variable for the EduInsight Next.js app.
#
# For local development: copy this file to .env.local and fill in the value.
# For Vercel deployment: add this variable in the Vercel project settings under
#   Project → Settings → Environment Variables → Add New
#
# The Convex backend is public/read-only — no auth token required.
NEXT_PUBLIC_CONVEX_URL=https://determined-mongoose-938.convex.cloud

# ── AI insights (/api/insights) via Claude in Amazon Bedrock ──
# IAM user/role needs bedrock-mantle:CreateInference on the model.
# BEDROCK_-prefixed because Vercel reserves AWS_* variable names.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials:
# BEDROCK_SESSION_TOKEN=
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-haiku-4-5
# Per-MTok prices used for the daily budget — set to your Bedrock rates:
# LLM_INPUT_USD_PER_MTOK=1
# LLM_OUTPUT_USD_PER_MTOK=5
